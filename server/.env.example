LEGALBRIDGE_APP_NAME=LegalBridge India API
LEGALBRIDGE_ENVIRONMENT=development
LEGALBRIDGE_API_V1_PREFIX=/api/v1
LEGALBRIDGE_HOST=127.0.0.1
LEGALBRIDGE_PORT=8000
LEGALBRIDGE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LEGALBRIDGE_LOG_LEVEL=INFO
LEGALBRIDGE_DOCS_ENABLED=true
LEGALBRIDGE_DATABASE_URL=sqlite+aiosqlite:///./legalbridge.db
DATABASE_SSL=disable
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
LEGALBRIDGE_SQL_ECHO=false
LEGALBRIDGE_ACCESS_TOKEN_MINUTES=15
LEGALBRIDGE_REFRESH_TOKEN_DAYS=7
LEGALBRIDGE_JWT_ALGORITHM=HS256
# Development-only default. Replace this with a strong private value outside localhost.
LEGALBRIDGE_JWT_SECRET=legalbridge-development-only-secret-change-before-production
LEGALBRIDGE_STORAGE_ROOT=./data/uploads
LEGALBRIDGE_MAX_UPLOAD_BYTES=52428800
LEGALBRIDGE_OCR_ENABLED=false
# Optional absolute path or executable name. Tesseract is never installed by this project.
LEGALBRIDGE_TESSERACT_COMMAND=
LEGALBRIDGE_EXTRACTION_TEXT_LIMIT=2000000
LEGALBRIDGE_EXTRACTION_PAGE_TEXT_LIMIT=200000
LEGALBRIDGE_EXTRACTION_MAX_PAGES=1000
